msgstr "Lunghezza del mosso, in pixel della foto"

#: cornice.py:645
msgid "Direction"
msgstr "Direzione"

#: cornice.py:646
msgid "0° horizontal, 90° vertical"
msgstr "0° orizzontale, 90° verticale"

#: cornice.py:647
